# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the example files committed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local job data (uploads + rendered output)
/data/uploads/*
!/data/uploads/.gitkeep
/data/output/*
!/data/output/.gitkeep

# media anywhere in the repo
*.mp4
*.mkv
*.mov
*.mp3
*.wav
*.webm
*.avi
*.m4a
*.aac
*.flac
*.ogg
*.srt

# generated frames/thumbnails inside data (not public/)
/data/**/*.jpg
/data/**/*.jpeg
/data/**/*.png
/data/**/*.gif

# editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# python leftovers
__pycache__/
*.pyc